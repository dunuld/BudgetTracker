{
  "name": "budget-tracker",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:server": "node -e \"require('node:fs').rmSync('dist/server',{recursive:true,force:true})\" && tsc -p server/tsconfig.json && node -e \"require('node:fs').cpSync('server/src/db/schema.sql','dist/server/server/src/db/schema.sql')\"",
    "build:all": "ng build && npm run build:server",
    "dev:server": "tsx watch server/src/main.ts",
    "start:server": "node dist/server/server/src/main.js",
    "test:server": "vitest run --config server/vitest.config.ts"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "chart.js": "^4.6.1",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pdfjs-dist": "^6.5.438",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "jsdom": "^30.0.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.8.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
